#!/usr/bin/env bash
#
# Everything that has to pass before a change is finished.
#
# This exists because of a specific mistake, made twice in one night. Running the checks by
# hand as `pytest | tail -1 && ruff && tsc` reports the exit status of `tail`, not of pytest —
# so a red suite scrolled past as one line of green and a commit went out on top of it. A
# pipeline hides the failure it is summarising.
#
#   ./check         everything
#   ./check server  python only (fast loop while working on the backend)
#   ./check ui      typescript only
#
# There used to be a `lint` mode here — ruff and format only, no pytest — because the suite
# did not run on a machine that was not a developer's. A clean checkout failed ~200 tests on
# environment rather than on behaviour, so gating releases on it would have meant never
# releasing. It is gone, along with the reasons for it:
#
#   * `CONFIG_DB_PATH` is resolved at import as `DATA_DIR / "config.db"`, so redirecting
#     `DATA_DIR` never touched it and every test read the developer's real config database —
#     including its `permission_mode`, which on the machine this was written on was `bypass`.
#     The gate was switched off for the whole suite, and absent on a fresh clone.
#   * `permissions._linked` cached which folders are linked projects for five seconds and
#     nothing reset it between tests, so an outcome depended on how fast the preceding tests
#     ran.
#   * one guard asked whether the skills folder existed rather than whether anything was in
#     it, and `skills.root()` conjures an empty one with `mkdir(exist_ok=True)`.
#
# Verified by building a tree from `git ls-files` alone — no `server/data`, no config
# database, no skills — and running the suite in it: 0 failures.
#
# Note `tsc -b`, not `tsc --noEmit`. They read different configs: --noEmit passed clean on a
# tree where the real build failed with six errors, two of them genuine type mismatches.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
what="${1:-all}"
failed=()

step() {
  local name="$1"; shift
  printf '\n\033[1m▸ %s\033[0m\n' "$name"
  if "$@"; then
    printf '\033[32m  ✓ %s\033[0m\n' "$name"
  else
    printf '\033[31m  ✗ %s\033[0m\n' "$name"
    failed+=("$name")
  fi
}

if [[ "$what" == "all" || "$what" == "server" ]]; then
  cd "${here}/server"
  step "ruff"   .venv/bin/python -m ruff check kith/ tests/
  step "format" .venv/bin/python -m ruff format --check kith/ tests/
  step "pytest" .venv/bin/python -m pytest tests/ -q
fi

if [[ "$what" == "all" || "$what" == "ui" ]]; then
  cd "${here}/ui"
  # --force so a stale .tsbuildinfo cannot report success for code it never looked at.
  step "tsc" npx tsc -b --force
  # Between tsc and the build, because a type error makes every component test fail in the same
  # unhelpful way, and a broken build is worth knowing about even when the tests pass.
  #
  # This step is why it exists: five interface changes shipped broken in one day, every one of
  # them with tsc green, because tsc checks that the types agree and nothing checked that the
  # thing worked. That difference was landing on whoever was looking at the screen.
  step "vitest" npm test --silent
  step "vite build" npm run build
fi

printf '\n'
if (( ${#failed[@]} )); then
  printf '\033[31m%d check(s) failed: %s\033[0m\n' "${#failed[@]}" "${failed[*]}"
  exit 1
fi
printf '\033[32mall checks passed\033[0m\n'
