{
  "manifest": 1,
  "id": "browser",
  "name": "Browser",
  "version": "0.4.0",
  "description": "A browser in a Kith tab. You use it with your hands; he drives the same page.",
  "publisher": "Kith",
  "license": "MIT",
  "surfaces": [
    {
      "id": "page",
      "title": "Browser",
      "kind": "web",
      "icon": "globe",
      "minWidth": 480,
      "minHeight": 360,
      "instances": "single",
      "answers": "conversation"
    }
  ],
  "commands": [
    {
      "name": "open",
      "title": "Open a page",
      "description": "Go to an address. Waits for it to settle, then answers with the title and final URL.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "open"
      },
      "params": {
        "url": {
          "type": "string",
          "maxLength": 1000,
          "description": "The address to open."
        }
      },
      "required": [
        "url"
      ],
      "returns": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "failure": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "read",
      "title": "Read the page",
      "description": "The page's visible text, as a person would read it. A few hundred tokens — reach for it before a picture.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "read"
      },
      "params": {},
      "returns": {
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "click",
      "title": "Click something",
      "description": "Click by what it says — click(text: \"Sign in\"), or a selector for an unlabelled icon. If nothing matches, the answer lists what is clickable.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "click"
      },
      "params": {
        "text": {
          "type": "string",
          "maxLength": 200,
          "description": "The words on it."
        },
        "selector": {
          "type": "string",
          "maxLength": 200,
          "description": "A CSS selector, when text will not do."
        }
      },
      "returns": {
        "clicked": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "options": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "type",
      "title": "Type into the page",
      "description": "Type into what is focused, or name a field with `into`. A paste, so it survives fields that reformat as you go.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "type"
      },
      "params": {
        "text": {
          "type": "string",
          "maxLength": 1000,
          "description": "What to type."
        },
        "into": {
          "type": "string",
          "maxLength": 200,
          "description": "The field's label or selector, if it needs focusing."
        }
      },
      "required": [
        "text"
      ],
      "returns": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "press",
      "title": "Press a key",
      "description": "A key rather than a character — Enter, Tab, Escape.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "press"
      },
      "params": {
        "key": {
          "type": "string",
          "enum": [
            "Enter",
            "Tab",
            "Escape",
            "Backspace",
            "ArrowDown",
            "ArrowUp"
          ],
          "description": "Which key."
        }
      },
      "required": [
        "key"
      ],
      "returns": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "scroll",
      "title": "Scroll the page",
      "description": "Down by pixels, up with a negative one. For pages that load as you scroll — `read` already returns text below the fold.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "scroll"
      },
      "params": {
        "by": {
          "type": "number",
          "minimum": -20000,
          "maximum": 20000,
          "description": "Pixels; negative scrolls up."
        }
      },
      "returns": {
        "url": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "look",
      "title": "Look at the page",
      "description": "A screenshot, to a file — the whole page, or one part with look(text: \"Pricing\"). A crop is far cheaper to read.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "look"
      },
      "params": {
        "text": {
          "type": "string",
          "maxLength": 200,
          "description": "Words on the one thing to picture. Omit for the page."
        },
        "selector": {
          "type": "string",
          "maxLength": 200,
          "description": "A CSS selector, when text will not do."
        }
      },
      "returns": {
        "shot": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "options": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "resize",
      "title": "Resize the page",
      "description": "Lay the page out at another size, then read or look. A preset, exact pixels, or a ratio. It really lays out at that size even in a smaller pane; \"reset\" puts it back.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "resize"
      },
      "params": {
        "preset": {
          "type": "string",
          "enum": [
            "reset",
            "phone",
            "phone-landscape",
            "tablet",
            "tablet-landscape",
            "laptop",
            "desktop",
            "square"
          ],
          "description": "A named device size."
        },
        "width": {
          "type": "integer",
          "minimum": 200,
          "maximum": 3840,
          "description": "Pixels across; alone, keeps the height."
        },
        "height": {
          "type": "integer",
          "minimum": 200,
          "maximum": 2160,
          "description": "Pixels down; alone, keeps the width."
        },
        "ratio": {
          "type": "string",
          "description": "\"16:9\", \"9:16\" — settles the side you leave out."
        }
      },
      "returns": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "scale": {
          "type": "number"
        }
      },
      "timeout_ms": 10000,
      "model": true
    },
    {
      "name": "show",
      "title": "Open the Browser tab",
      "description": "Put the Browser tab on screen — before a screenshot, or so they can use it themselves.",
      "delivery": "host",
      "surface": "page",
      "does": {
        "host": "open_surface"
      },
      "params": {},
      "returns": {
        "opened": {
          "type": "boolean"
        }
      },
      "timeout_ms": 8000,
      "model": true
    }
  ]
}
