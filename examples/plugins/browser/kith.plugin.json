{
  "manifest": 1,
  "id": "browser",
  "name": "Browser",
  "version": "0.3.0",
  "description": "A browser in a Kith tab. You use it with your hands; he drives the same page.",
  "publisher": "Kith",
  "license": "MIT",
  "surfaces": [
    {
      "id": "page",
      "title": "Browser",
      "kind": "web",
      "icon": "globe",
      "minWidth": 480,
      "minHeight": 360,
      "instances": "single",
      "answers": "conversation"
    }
  ],
  "commands": [
    {
      "name": "open",
      "title": "Open a page",
      "description": "Go to an address. Waits until the page settles, and answers with its title and where it ended up after redirects.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "open"
      },
      "params": {
        "url": {
          "type": "string",
          "maxLength": 1000,
          "description": "The address to open."
        }
      },
      "required": [
        "url"
      ],
      "returns": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "failure": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "read",
      "title": "Read the page",
      "description": "The visible text of the page, as a person would read it. A few hundred tokens for an ordinary page. Reach for this before looking at a picture.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "read"
      },
      "params": {},
      "returns": {
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "click",
      "title": "Click something",
      "description": "Click by what it says \u2014 click(text: \"Sign in\"). A selector works for an icon with no label. If nothing matches, the answer lists what is clickable.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "click"
      },
      "params": {
        "text": {
          "type": "string",
          "maxLength": 200,
          "description": "The words on the thing to click."
        },
        "selector": {
          "type": "string",
          "maxLength": 200,
          "description": "A CSS selector, when text will not do."
        }
      },
      "returns": {
        "clicked": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "options": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "type",
      "title": "Type into the page",
      "description": "Type into whatever is focused, or name a field with `into` to click it first. A paste, so it survives fields that reformat as you go.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "type"
      },
      "params": {
        "text": {
          "type": "string",
          "maxLength": 1000,
          "description": "What to type."
        },
        "into": {
          "type": "string",
          "maxLength": 200,
          "description": "The field's label or selector, if it needs focusing first."
        }
      },
      "required": [
        "text"
      ],
      "returns": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "press",
      "title": "Press a key",
      "description": "A key that means something rather than a character \u2014 Enter to submit a form, Tab to move on, Escape to dismiss.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "press"
      },
      "params": {
        "key": {
          "type": "string",
          "enum": [
            "Enter",
            "Tab",
            "Escape",
            "Backspace",
            "ArrowDown",
            "ArrowUp"
          ],
          "description": "Which key."
        }
      },
      "required": [
        "key"
      ],
      "returns": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "scroll",
      "title": "Scroll the page",
      "description": "Scroll down by a number of pixels, or up with a negative one. Only needed for pages that load as you scroll \u2014 `read` already returns text below the fold.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "scroll"
      },
      "params": {
        "by": {
          "type": "number",
          "minimum": -20000,
          "maximum": 20000,
          "description": "Pixels; negative scrolls up."
        }
      },
      "returns": {
        "url": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "look",
      "title": "Look at the page",
      "description": "A screenshot, written to a file. Costs almost nothing until you read it \u2014 and reading one costs a few thousand tokens, so only look when layout is the question or they asked what it looks like.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "look"
      },
      "params": {},
      "returns": {
        "shot": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "timeout_ms": 40000,
      "model": true
    },
    {
      "name": "resize",
      "title": "Resize the page",
      "description": "Lay the page out at another size; read or look afterwards. Preset \"reset\" puts it back to the full tab.",
      "delivery": "view",
      "surface": "page",
      "does": {
        "act": "resize"
      },
      "params": {
        "preset": {
          "type": "string",
          "enum": [
            "reset",
            "phone",
            "phone-landscape",
            "tablet",
            "tablet-landscape",
            "laptop",
            "desktop",
            "square"
          ],
          "description": "phone 390\u00d7844, tablet 820\u00d71180, laptop 1280\u00d7800, desktop 1920\u00d71080, square 900\u00d7900."
        },
        "width": {
          "type": "integer",
          "minimum": 200,
          "maximum": 3840,
          "description": "Width in pixels; alone, keeps the height."
        },
        "height": {
          "type": "integer",
          "minimum": 200,
          "maximum": 2160,
          "description": "Height in pixels; alone, keeps the width."
        }
      },
      "returns": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "timeout_ms": 10000,
      "model": true
    },
    {
      "name": "show",
      "title": "Open the Browser tab",
      "description": "Put the Browser tab on screen \u2014 before a screenshot, or so they can look and click it themselves.",
      "delivery": "host",
      "surface": "page",
      "does": {
        "host": "open_surface"
      },
      "params": {},
      "returns": {
        "opened": {
          "type": "boolean"
        }
      },
      "timeout_ms": 8000,
      "model": true
    }
  ]
}
