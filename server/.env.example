# Copy to .env (or just export these) to override defaults. All optional.

# PORT=8611
# OLLAMA_HOST=http://127.0.0.1:11434
# KITH_DATA_DIR=./data          # where the SQLite databases live

# These seed / are overridden against the config database (env wins over the DB):
# KITH_MODEL=qwen3:4b
# KITH_NUM_CTX=40960
# KITH_NUM_PREDICT=8192
# KITH_THINK=1

# Persona: by default it's merged from the persona/ folder. Override the folder:
# KITH_PERSONA_DIR=/path/to/persona
# ...or bypass the folder entirely with one inline prompt:
# KITH_SYSTEM="Your own custom persona here"
