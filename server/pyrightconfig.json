{
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "kith",
    "tests",
    "scripts",
    "app.py"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "data",
    "build",
    "dist",
    ".venv"
  ],
  "typeCheckingMode": "standard",
  "reportMissingImports": "error",
  "executionEnvironments": [
    {
      "root": "tests",
      "reportOptionalSubscript": "none",
      "reportOptionalMemberAccess": "none",
      "reportOptionalOperand": "none",
      "reportOptionalCall": "none",
      "extraPaths": [
        "."
      ]
    }
  ]
}
